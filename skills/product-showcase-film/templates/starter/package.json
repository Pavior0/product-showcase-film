{
  "name": "psf-starter",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "cues": "node scripts/cues.mjs",
    "render": "node scripts/render.mjs",
    "render:1080": "node scripts/render.mjs --scale 1",
    "render:4k": "node scripts/render.mjs --scale 2",
    "check:determinism": "node scripts/determinism.mjs --from 3 --dur 2",
    "fonts": "node scripts/fetch-fonts.mjs",
    "vendor-themes": "node scripts/vendor-themes.mjs",
    "check:themes": "node scripts/vendor-themes.mjs --check"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "esbuild": "^0.25.12"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
